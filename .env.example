# GEMINI_API_KEY: Required for Google GenAI SDK calls to hosted Gemma models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_MODEL: Hosted Gemma model ID used for all AI calls (do NOT use Gemini models).
# Supported hosted Gemma models: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL="gemma-4-26b-a4b-it"

# CLICKUP_API_TOKEN: Personal ClickUp API token (sent as raw Authorization header, not Bearer).
# Leave empty to run automatically in Demo / Mock Mode.
CLICKUP_API_TOKEN=""

# CLICKUP_LIST_IDS: Comma-separated ClickUp List IDs representing tracked releases.
# Example: "901200101,901200102"
CLICKUP_LIST_IDS=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
